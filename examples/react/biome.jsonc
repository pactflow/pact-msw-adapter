{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": false,
  "extends": "//",
  "javascript": {
    // Cypress injects these at runtime
    "globals": ["cy", "Cypress"]
  },
  "linter": {
    "domains": { "react": "recommended" }
  },
  "overrides": [
    {
      // Generated by `msw init`, not ours to lint or format
      "includes": ["public/mockServiceWorker.js"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
